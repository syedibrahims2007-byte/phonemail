# PhoneMail - Phone-Number-Based Authentication System
# Copy this file to .env and fill in your values

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3000
APP_DOMAIN=phonemail.app
WEBHOOK_BASE_URL=https://your-domain.com

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/phonemail

# ============================================================
# REDIS (for queues, caching, rate limiting)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# JWT & ENCRYPTION
# ============================================================
JWT_SECRET=your-super-long-random-secret-key-min-32-chars
PII_MASTER_KEY=separate-32-char-key-for-pii-encryption
BLIND_INDEX_KEY=separate-32-char-key-for-blind-index

# ============================================================
# TWILIO (SMS, Voice, WhatsApp)
# ============================================================
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_NUMBER=whatsapp:+15551234567

# Twilio WhatsApp Template SIDs (create in Twilio Console)
WHATSAPP_OTP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_SECURITY_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_TRANSACTIONAL_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_BILLING_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_MARKETING_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_UTILITY_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# FIREBASE / FCM (Push Notifications)
# ============================================================
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR use project ID:
# FCM_PROJECT_ID=your-project-id

# ============================================================
# WEB PUSH (VAPID keys for browser push)
# Generate with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC=your-vapid-public-key
VAPID_PRIVATE=your-vapid-private-key

# ============================================================
# WEB AUTHN / PASSKEYS
# ============================================================
WEBAUTHN_RP_ID=phonemail.app
WEBAUTHN_ORIGIN=https://phonemail.app

# ============================================================
# EMAIL PROXY (for vendor integrations)
# ============================================================
PROXY_EMAIL_DOMAIN=proxy.phonemail.app
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-signing-key
SMTP_HOST=smtp.mailgun.org
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ============================================================
# COUNTRY CONFIG (comma-separated ISO codes to enable)
# ============================================================
ENABLED_COUNTRIES=US,IN,GB,CA,AU

# ============================================================
# SMS PUMPING PROTECTION
# ============================================================
DAILY_SMS_SPEND_CAP_USD=1000
MONTHLY_SMS_SPEND_CAP_USD=20000

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info